{
  "name": "natux-world-launcher",
  "version": "1.10.0",
  "description": "NATUX WORLD - Premium Minecraft Launcher",
  "type": "module",
  "private": true,
  "author": "NATUX WORLD",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "npm run tauri:dev",
    "dev:web": "vite --config config/vite.tauri.config.ts",
    "electron:install": "npm ci --prefix electron",
    "electron:dev": "node scripts/run-electron.mjs dev",
    "dev:tauri:web": "vite --config config/vite.tauri.config.ts",
    "build:tauri:web": "npm run prepare:icons && tsc -p tsconfig.app.json && vite build --config config/vite.tauri.config.ts",
    "prepare:icons": "node scripts/prepare-launcher-icons.mjs",
    "build:lock-runtime": "node scripts/build-lock-runtime.mjs",
    "test:lock-agent": "node scripts/test-lock-agent.mjs",
    "tauri:dev": "npm run build:lock-runtime && node scripts/run-tauri.mjs dev",
    "tauri:build": "npm run build:lock-runtime && node scripts/run-tauri.mjs build",
    "tauri:build:updater": "npm run build:lock-runtime && node scripts/run-tauri.mjs build --config src/native/tauri.updater.conf.json",
    "build": "npm run prepare:icons && npm run build:lock-runtime && node scripts/run-tauri.mjs build",
    "build:web": "npm run build:tauri:web",
    "build:portable": "npm run build -- --no-bundle && node scripts/package-tauri-portable.mjs",
    "electron:build:web": "node scripts/run-electron.mjs build:web",
    "electron:build": "node scripts/run-electron.mjs build",
    "electron:package": "node scripts/run-electron.mjs package",
    "test:electron": "node scripts/run-electron.mjs test",
    "typecheck:electron": "node scripts/run-electron.mjs typecheck",
    "lint": "eslint .",
    "preview": "vite preview",
    "sign:update-manifest": "node scripts/sign-update-manifest.mjs",
    "test": "vitest run",
    "test:release:workflow": "node --test tests/scripts/release-workflow.test.mjs tests/scripts/release-immutability.test.mjs",
    "test:icons": "node --test tests/scripts/prepare-launcher-icons.test.mjs",
    "test:watch": "vitest",
    "test:packaged": "node --test tests/e2e/tauri-packaged.test.cjs",
    "test:electron:packaged": "node --test tests/e2e/packaged.test.cjs",
    "test:portable": "node --test tests/e2e/tauri-portable.test.cjs",
    "test:tauri:packaged": "node --test tests/e2e/tauri-packaged.test.cjs",
    "test:tauri:installed": "node --test tests/e2e/tauri-installed.test.cjs",
    "test:tauri:upgrade": "node --test tests/e2e/tauri-upgrade.test.cjs",
    "test:tauri:live": "node --test tests/e2e/tauri-live.test.cjs",
    "test:packaged:live": "node --test tests/e2e/tauri-live.test.cjs",
    "test:electron:live": "node --test tests/e2e/packaged-live.test.cjs",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "framer-motion": "^11.11.17",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.460.0",
    "playwright-core": "1.63.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "zustand": "^5.0.1"
  }
}
