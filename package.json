{
  "name": "natux-world-launcher",
  "version": "1.9.15",
  "description": "NATUX WORLD - Premium Minecraft Launcher",
  "main": "dist-electron/main.js",
  "type": "module",
  "private": true,
  "author": "NATUX WORLD",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "predev": "npm run build:lock-runtime",
    "dev:tauri:web": "vite --config config/vite.tauri.config.ts",
    "build:tauri:web": "tsc -p tsconfig.app.json && vite build --config config/vite.tauri.config.ts",
    "build:lock-runtime": "node scripts/build-lock-runtime.mjs",
    "test:lock-agent": "node scripts/test-lock-agent.mjs",
    "tauri:dev": "npm run build:lock-runtime && node scripts/run-tauri.mjs dev",
    "tauri:build": "npm run build:lock-runtime && node scripts/run-tauri.mjs build",
    "tauri:build:updater": "npm run build:lock-runtime && node scripts/run-tauri.mjs build --config src/native/tauri.updater.conf.json",
    "build": "npm run build:lock-runtime && tsc -b && vite build && electron-builder",
    "build:web": "tsc -b && vite build",
    "electron:build": "npm run build:lock-runtime && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview",
    "sign:update-manifest": "node scripts/sign-update-manifest.mjs",
    "test": "vitest run",
    "test:release:workflow": "node --test tests/scripts/release-workflow.test.mjs",
    "test:watch": "vitest",
    "test:packaged": "node --test tests/e2e/packaged.test.cjs",
    "test:tauri:packaged": "node --test tests/e2e/tauri-packaged.test.cjs",
    "test:tauri:installed": "node --test tests/e2e/tauri-installed.test.cjs",
    "test:tauri:live": "node --test tests/e2e/tauri-live.test.cjs",
    "test:packaged:live": "node --test tests/e2e/packaged-live.test.cjs",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "@xhayper/discord-rpc": "^1.3.4",
    "electron-updater": "^6.3.9",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^9.17.0",
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^3.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "electron": "^43.1.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "framer-motion": "^11.11.17",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.460.0",
    "playwright-core": "1.63.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.9",
    "zustand": "^5.0.1"
  }
}
