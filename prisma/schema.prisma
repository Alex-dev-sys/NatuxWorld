generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id
  username           String    @unique
  email              String    @unique
  passwordHash       String
  emailVerified      Boolean   @default(false)
  verifyCode         String?
  verifyCodeExpires  DateTime?
  createdAt          DateTime  @default(now())
}

model Coupon {
  code        String    @id
  type        String
  value       Int
  description String    @default("")
  maxUses     Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  active      Boolean   @default(true)
}

model GameToken {
  accessToken String   @id
  clientToken String
  userId      String
  serverId    String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([serverId])
}

model LoginEvent {
  id        String   @id @default(uuid())
  userId    String?
  ip        String
  userAgent String   @default("")
  kind      String   // login | verify | register | fail
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Order {
  id                   String    @id @default(uuid())
  publicId             String    @unique @default(uuid())
  productId            String
  productName          String
  variantDuration      String
  variantDurationLabel String
  price                Int
  originalPrice        Int?
  couponCode           String?
  username             String
  status               String    @default("waiting_payment")
  paymentId            String?   @unique
  createdAt            DateTime  @default(now())
  paidAt               DateTime?
  deliveredAt          DateTime?
  deliveryError        String?
  rconCommands         String[]
  retryCount           Int       @default(0)
}
