generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id
  username           String    @unique
  /// Precomputed offline-mode UUID (v3, md5 of 'OfflinePlayer:' + username).
  /// Kept in sync by register / admin set-username; backfilled by migration.
  uuid               String    @unique
  email              String    @unique
  passwordHash       String
  emailVerified      Boolean   @default(false)
  tokenVersion       Int       @default(0)
  /// Stores sha256 of the 6-digit code, never the code itself.
  verifyCode         String?
  verifyCodeExpires  DateTime?
  bannedAt           DateTime?
  banReason          String?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorMethod      String?
  totpSecretEnc        String?
  /// Enrollment-in-progress secret. Kept apart from totpSecretEnc so that opening
  /// the QR screen never invalidates the authenticator that is currently active;
  /// promoted by /2fa/totp/enable and discarded after pendingTotpExpires.
  pendingTotpSecretEnc String?
  pendingTotpExpires   DateTime?
  twoFactorCode        String?
  twoFactorCodeExpires DateTime?
  backupCodes          TwoFactorBackupCode[]
  appPasswords         AppPassword[]
  createdAt          DateTime  @default(now())
}

model TwoFactorBackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AppPassword {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  hash       String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

model Coupon {
  code        String    @id
  type        String
  value       Int
  description String    @default("")
  maxUses     Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  active      Boolean   @default(true)
}

model GameToken {
  /// Stores sha256 of the access token, never the raw value.
  accessToken String   @id
  clientToken String
  userId      String
  tokenVersion Int     @default(0)
  serverId    String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([serverId])
}

model LoginEvent {
  id        String   @id @default(uuid())
  userId    String?
  ip        String
  userAgent String   @default("")
  kind      String   // login | verify | register | fail
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model GameEvent {
  id        String   @id @default(uuid())
  /// Client-generated id; unique index makes ingestion idempotent
  /// (createMany + skipDuplicates drops replayed events).
  eventId   String?  @unique
  userId    String?
  username  String
  kind      String   // command | block_break | block_place | chat | join | quit | death | kill
  message   String   @default("")
  world     String   @default("")
  x         Float?
  y         Float?
  z         Float?
  extra     String   @default("") // block type, victim name, etc.
  createdAt DateTime @default(now())

  @@index([username])
  @@index([userId])
  @@index([createdAt])
  @@index([kind])
}

model CrashReport {
  id        String   @id @default(uuid())
  kind      String
  stage     String
  message   String
  exitCode  Int?
  logs      String[]
  version   String   @default("")
  platform  String   @default("")
  arch      String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([kind])
}

model Order {
  id                   String    @id @default(uuid())
  publicId             String    @unique @default(uuid())
  productId            String
  productName          String
  variantDuration      String
  variantDurationLabel String
  price                Int
  originalPrice        Int?
  couponCode           String?
  username             String
  status               String    @default("waiting_payment")
  paymentId            String?   @unique
  paymentAsset         String?
  paymentAmount        String?
  createdAt            DateTime  @default(now())
  paidAt               DateTime?
  deliveredAt          DateTime?
  deliveryError        String?
  fulfillmentCommands String[]
  rconCommands         String[]
  retryCount           Int       @default(0)
  /// Owner of the in-flight delivery attempt, plus the lease it holds. A retry
  /// may only start by winning an atomic claim, so concurrent admin retries of
  /// the same order cannot both reach RCON. A stale lease (past its expiry) is
  /// reclaimable — a crashed attempt must not block the order forever.
  deliveryAttemptId    String?
  deliveryLeaseUntil   DateTime?
  /// Provider checkout link for an order still awaiting payment, so the buyer
  /// can return to THIS order instead of starting a duplicate one in the shop.
  /// Cleared once the order leaves waiting_payment.
  paymentUrl           String?
}

/// Server-side allowlist of live admin sessions. A cookie is only accepted while
/// its row exists, so logout (or a wiped table) genuinely ends the session —
/// an in-process revocation set forgot everything on restart and let a
/// logged-out cookie back in for the rest of its seven-day lifetime.
model AdminSession {
  sid       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model AdminAudit {
  id        String   @id @default(cuid())
  action    String
  target    String?
  params    Json
  ip        String
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model Product {
  id          String           @id
  slug        String           @unique
  name        String
  description  String
  color       String
  order       Int
  active      Boolean          @default(true)
  badge       String?
  popular     Boolean          @default(false)
  perks       String[]
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([order])
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  duration      String
  durationLabel String
  price         Int
  commands      String[]
  order         Int      @default(0)

  @@index([productId])
}

/// News entries shown in the launcher's news tab. Managed via admin/CMS later;
/// for now seeded by the release process.
model NewsPost {
  id          String   @id // slug, e.g. "1-21-1-forge-update"
  title       String
  description String   @default("")
  body        String   @default("")
  image       String   @default("")
  category    String   @default("update") // update | event | donate | wipe
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([published, createdAt])
}

/// Count-only launcher telemetry (opt-in, no identifiers). One row per
/// event/version/platform/day; each POST increments the counter.
model LauncherEventStat {
  id       String   @id @default(uuid())
  event    String // install_ok | install_fail | launch_ok | game_crash
  version  String
  platform String
  arch     String
  day      DateTime @db.Date
  count    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([event, version, platform, arch, day])
}
