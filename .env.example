# Общие настройки сайта
NEXT_PUBLIC_SERVER_NAME="NATUX WORLD"
NEXT_PUBLIC_SITE_DOMAIN="vibestudy.ru"
NEXT_PUBLIC_SERVER_IP="mc.vibestudy.ru"
NEXT_PUBLIC_SERVER_VERSION="1.20.1 - 1.21.x"
NEXT_PUBLIC_LOGO_URL="/logo.png"

# Соцсети
NEXT_PUBLIC_VK_URL="https://vk.com/natuxworld"
NEXT_PUBLIC_DISCORD_URL="#"
NEXT_PUBLIC_TELEGRAM_URL="#"
NEXT_PUBLIC_YOUTUBE_URL="#"

# Платёжная система (mock | cryptobot | yookassa | multi)
# multi = ЮKassa для карт/СБП + CryptoBot для крипты
PAYMENT_PROVIDER="mock"
# (зарезервировано, пока не используется)
PAYMENT_WEBHOOK_SECRET="change_me"

# YooMoney HTTP notifications (если PAYMENT_PROVIDER=yoomoney)
YOOMONEY_WALLET="your_wallet"
YOOMONEY_SECRET="change_me_yoomoney_secret"

# ЮKassa (если PAYMENT_PROVIDER=yookassa или multi)
YOOKASSA_SHOP_ID="your_shop_id"
YOOKASSA_SECRET_KEY="your_secret_key"

# CryptoBot (если PAYMENT_PROVIDER=cryptobot)
# Токен приложения из @CryptoBot в Telegram (Apps → Create App)
CRYPTO_BOT_TOKEN="change_me_cryptobot_token"
# mainnet | testnet
CRYPTO_BOT_NETWORK="mainnet"

# Будущие настройки RCON
RCON_HOST="127.0.0.1"
RCON_PORT="25575"
RCON_PASSWORD="change_me"

# База данных (локально без Docker)
DATABASE_URL="postgresql://natux:change_me@localhost:5432/natux"

# Пароль PostgreSQL (только для docker-compose)
POSTGRES_PASSWORD="change_me"

# JWT для токенов пользователей (обязательно: мин. 32 случайных символа)
# Генерация: openssl rand -hex 32
JWT_SECRET="change_me_min_32_chars_long_random_secret_here"

# SMTP для отправки кодов подтверждения email
# Yandex: host=smtp.yandex.ru port=465 (SSL) / 587 (STARTTLS)
# Gmail:  host=smtp.gmail.com port=465 (SSL) / 587 (STARTTLS)
# Resend: host=smtp.resend.com port=465, user=resend, pass=<api_key>
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_USER="your_email@yandex.ru"
SMTP_PASS="your_app_password"
# Адрес отправителя (должен совпадать с SMTP_USER для Yandex/Gmail)
MAIL_FROM="NATUX WORLD <your_email@yandex.ru>"

# Админ-панель (обязательно поменяй перед деплоем)
ADMIN_PASSWORD="change_me_password"
ADMIN_SECRET="change_me_long_random_secret_min_32_chars"
# TOTP secret для обязательного второго фактора администратора
ADMIN_TOTP_SECRET="change_me_base32_totp_secret"
# Разрешённые production IP администратора через запятую
ADMIN_ALLOWED_IPS="127.0.0.1"

# Ключ API Paper-плагина и AES-256 ключ для шифрования TOTP пользователей
GAME_API_KEY="change_me_game_api_key"
# Генерация: openssl rand -hex 32
TWOFA_ENC_KEY="change_me_64_hex_characters"

# Время жизни Yggdrasil game token (1..720 часов)
GAME_TOKEN_TTL_HOURS="24"

# Yggdrasil (authlib-injector) — RSA-2048 приватный ключ для подписи профилей
# Генерация: openssl genrsa 2048 | awk 'NF {sub(/\r/, ""); printf "%s\\n",$0}' > key.pem
# Вставь содержимое key.pem (однострочно с \n) как значение переменной:
YGGDRASIL_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# SSH forced-command bridge управления Minecraft-хостом (опционально)
MC_SSH_HOST="host.docker.internal"
MC_SSH_USER="agfa"
MC_SSH_KEY_B64="change_me_base64_private_key"

# Акция/баннер распродажи (баннер скрыт, если NEXT_PUBLIC_SALE_END не задан или в прошлом)
NEXT_PUBLIC_SALE_END="2026-06-30T23:59:59+03:00"
NEXT_PUBLIC_SALE_CODE="SUMMER25"
NEXT_PUBLIC_SALE_DISCOUNT="−25%"
