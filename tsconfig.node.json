{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    // TODO: enable "noUncheckedIndexedAccess": true as a follow-up. It surfaces
    // many errors in JSON-parsing services (MojangService etc.); fix first, then on.
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["vite.config.ts", "electron/**/*"]
}
